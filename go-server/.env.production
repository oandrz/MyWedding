GO_ENV=production
PORT=5000

# Database — DB_PASSWORD is substituted into DATABASE_URL by docker-compose
DB_PASSWORD=CHANGE_ME_strong_db_password
# DATABASE_URL is built in docker-compose.prod.yml using DB_PASSWORD above
REDIS_URL=redis://redis:6379

# Auth
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
SESSION_MAX_AGE=1800

# CORS — set to your domain (https://yourdomain.com) or public IP (http://x.x.x.x)
CORS_ORIGINS=http://YOUR_PUBLIC_IP

# Google Drive Integration (copy values from .env.development)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
SUPABASE_URL=urll
SUPABASE_SERVICE_KEY=key
SUPABASE_BUCKET_ID=bucket_id