GO_ENV=development
PORT=8080
# Leave empty or comment out to use in-memory fallback (zero dependencies for dev).
# If set but the service is unreachable, dev mode falls back gracefully; production exits.
DATABASE_URL=postgresql://wedding_user:wedding_password@localhost:5432/wedding_invitation_db
REDIS_URL=redis://localhost:6379
ADMIN_PASSWORD=your_admin_password
SESSION_MAX_AGE=1800
CORS_ORIGINS=https://yourdomain.com
GOOGLE_SERVICE_ACCOUNT_JSON=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_ID=