# MyWedding Go Server — Environment Variables
# Copy this file to go-server/.env.production (or set vars in your deployment environment).
# Values shown here are examples only — never commit real secrets.

# ─── Application ─────────────────────────────────────────────────────────────

# Runtime environment.  Must be "production" in live deployments.
# Controls CORS policy, cookie security, logging format, and whether the server
# exits (prod) or falls back (dev) when DB / Redis are unavailable.
# Required in production.
GO_ENV=production

# TCP port the HTTP server listens on.  Default: 5000.
# Optional.
PORT=5000

# Directory from which the Go server serves the compiled React frontend.
# Set to the path of the dist/public folder produced by `npm run build`.
# Optional (only needed when running the Go server as the sole process).
STATIC_DIR=/path/to/dist/public

# ─── Admin Authentication ─────────────────────────────────────────────────────

# Preferred: pre-hashed bcrypt password for the admin panel.
# Generate with: htpasswd -bnBC 10 "" yourpassword | tr -d ':\n'
# Required (one of ADMIN_PASSWORD_HASH or ADMIN_PASSWORD must be set).
ADMIN_PASSWORD_HASH=$2a$10$examplehashreplacethiswitharealbcrypthash

# Deprecated fallback: plaintext password (auto-hashed at startup).
# Use ADMIN_PASSWORD_HASH instead.  Default if neither is set: admin123 (insecure).
# ADMIN_PASSWORD=change-me-immediately

# Admin session lifetime in seconds.  Default: 1800 (30 minutes).
# Optional.
SESSION_MAX_AGE=1800

# ─── Database ────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Required in production (server exits on failure when GO_ENV=production).
DATABASE_URL=postgresql://wedding_user:password@localhost:5432/wedding_invitation_db

# ─── Session Store (Redis) ───────────────────────────────────────────────────

# Redis connection URL for persistent admin sessions.
# Required in production (server exits on failure when GO_ENV=production).
# Falls back to in-memory sessions when unset in development.
REDIS_URL=redis://localhost:6379

# ─── CORS (production only) ──────────────────────────────────────────────────

# Comma-separated list of allowed origins.  Only applied when GO_ENV=production.
# Example: https://your-domain.com,https://www.your-domain.com
# Required in production if the frontend is served from a different origin.
CORS_ORIGINS=https://your-domain.com

# ─── File Storage (Supabase) — optional ──────────────────────────────────────

# All three Supabase vars must be set together to enable cloud storage.
# If any is missing the server falls back to local filesystem storage.
# Not available in production without explicit storage configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_ID=wedding-assets

# ─── Google Drive Integration — optional ─────────────────────────────────────

# Base64-encoded service account JSON from Google Cloud Console.
# Encode with: base64 -i service-account.json | tr -d '\n'
# When unset, the Google Drive photo gallery feature is disabled.
GOOGLE_SERVICE_ACCOUNT_JSON=base64encodedserviceaccountjsonhere
